#!/bin/bash

USAGE=`cat << EOS
usage:
    sshp <SSH private key path> <user@proxy> <user@remote>
EOS
`

if [ $# -lt 3 ]; then
    echo "$USAGE"    
    exit 1
fi

SSH_PRIVATE_KEY=$1
PROXY_HOST=$2
REMOTE_HOST=$3

ssh -o "ProxyCommand=ssh -W %h:%p -i $SSH_PRIVATE_KEY $PROXY_HOST" -i $SSH_PRIVATE_KEY $REMOTE_HOST
